<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.codemonstur</groupId>
    <artifactId>templateer-parent</artifactId>
    <version>6</version>

    <packaging>pom</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Parent pom for templateer</description>
    <url>https://github.com/codemonstur/templateer</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>codemonstur</id>
            <name>Jurgen Voorneveld</name>
            <email>jegvoorneveld@gmail.com</email>
        </developer>
    </developers>

    <modules>
        <module>templateer-core</module>
        <module>templateer-bobplugin</module>
        <module>templateer-cli</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.release>17</maven.compiler.release>
        <maven.version>[3.6.3,)</maven.version>

        <version.library.bobthebuildtool>12</version.library.bobthebuildtool>
        <version.library.freemarker>2.3.35</version.library.freemarker>
        <version.library.handlebars>4.5.7</version.library.handlebars>
        <version.library.jcli>2.0.0</version.library.jcli>
        <version.library.junit>6.1.3</version.library.junit>
        <version.library.pebble>4.1.2</version.library.pebble>
        <version.library.slf4j>2.0.20</version.library.slf4j>
        <version.library.trimou>2.5.1.Final</version.library.trimou>
        <version.library.velocity>2.4.1</version.library.velocity>

        <version.plugin.check-cves>1.2.0</version.plugin.check-cves>
        <version.plugin.check-license>1.5.0</version.plugin.check-license>
        <version.plugin.codegrade>0.2.0</version.plugin.codegrade>
        <version.plugin.compiler>3.16.0</version.plugin.compiler>
        <version.plugin.enforcer>3.6.3</version.plugin.enforcer>
        <version.plugin.jar>3.5.1</version.plugin.jar>
        <version.plugin.javadoc>3.12.0</version.plugin.javadoc>
        <version.plugin.shade>3.6.2</version.plugin.shade>
        <version.plugin.source>3.4.0</version.plugin.source>
        <version.plugin.surefire>3.6.0</version.plugin.surefire>
            <version.library.pitest-junit5>1.2.3</version.library.pitest-junit5>
        <version.plugin.pitest>1.30.1</version.plugin.pitest>
        <!-- default for @{argLine}; jacoco's prepare-agent appends the agent when it runs -->
        <argLine></argLine>
            <version.plugin.jacoco>0.8.15</version.plugin.jacoco>
    </properties>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>com.github.codemonstur</groupId>
                <artifactId>templateer-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.codemonstur</groupId>
                <artifactId>bobthebuildtool</artifactId>
                <version>${version.library.bobthebuildtool}</version>
            </dependency>

            <dependency>
                <groupId>com.github.codemonstur</groupId>
                <artifactId>jcli</artifactId>
                <version>${version.library.jcli}</version>
            </dependency>

            <dependency>
                <groupId>com.github.jknack</groupId>
                <artifactId>handlebars</artifactId>
                <version>${version.library.handlebars}</version>
            </dependency>

            <dependency>
                <groupId>org.trimou</groupId>
                <artifactId>trimou-core</artifactId>
                <version>${version.library.trimou}</version>
            </dependency>

            <dependency>
                <groupId>io.pebbletemplates</groupId>
                <artifactId>pebble</artifactId>
                <version>${version.library.pebble}</version>
            </dependency>

            <dependency>
                <groupId>org.freemarker</groupId>
                <artifactId>freemarker</artifactId>
                <version>${version.library.freemarker}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${version.library.velocity}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${version.library.junit}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-nop</artifactId>
                <version>${version.library.slf4j}</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${version.plugin.jacoco}</version>
                <executions>
                    <execution>
                        <id>pre-unit-test</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>post-unit-test</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>


                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${version.plugin.enforcer}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${version.plugin.compiler}</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <release>${maven.compiler.release}</release>
                        <proc>full</proc>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${version.plugin.surefire}</version>
                                <configuration>
                    <argLine>@{argLine} -Xshare:off</argLine>
                </configuration>
            </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${version.plugin.jar}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${version.plugin.source}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${version.plugin.javadoc}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${version.plugin.shade}</version>
                </plugin>

                <plugin>
                    <groupId>com.github.codemonstur</groupId>
                    <artifactId>maven-check-license</artifactId>
                    <version>${version.plugin.check-license}</version>
                </plugin>

                <plugin>
                    <groupId>com.github.codemonstur</groupId>
                    <artifactId>maven-check-cves</artifactId>
                    <version>${version.plugin.check-cves}</version>
                <configuration>
                            <exclusions>
                                <exclusion>GHSA-j288-q9x7-2f5v</exclusion>
                            </exclusions>
                        
                        </configuration>
</plugin>

                <plugin>
                    <groupId>com.github.codemonstur</groupId>
                    <artifactId>codegrade-maven-plugin</artifactId>
                    <version>${version.plugin.codegrade}</version>
                </plugin>

            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${maven.version}</version>
                                    <message>This project requires Maven ${maven.version} to build</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.plugin.surefire}</version>
                            <configuration>
                    <argLine>@{argLine} -Xshare:off</argLine>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>

        <profile>
            <id>licenses</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-license</artifactId>
                        <version>${version.plugin.check-license}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                            <rules>
                                <rule>name:regex:BSD(\s|-)3-Clause( License)?</rule>
                                <rule>name:equal:GNU General Public License v2.0 w/Classpath exception</rule>
                                <rule>url:regex:http(s)?://www.apache.org/licenses/LICENSE-2.0.txt</rule>
                                <rule>url:equal:https://www.eclipse.org/legal/epl-v20.html</rule>
                                <rule>url:regex:https://opensource.org/license(s)?/(mit|MIT)</rule>
                            </rules>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>vulnerabilities</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-cves</artifactId>
                        <version>${version.plugin.check-cves}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>codequality</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>codegrade-maven-plugin</artifactId>
                        <version>${version.plugin.codegrade}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

            <profile>
            <id>mutation</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${version.plugin.pitest}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${version.library.pitest-junit5}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
</profiles>

</project>
