<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.codemonstur</groupId>
    <artifactId>templateer</artifactId>
    <version>6</version>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>A small tool to apply a properties file to a given template and get the output.</description>
    <url>https://github.com/codemonstur/templateer</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>codemonstur</id>
            <name>Jurgen Voorneveld</name>
            <email>jegvoorneveld@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.version>[3.6.3,)</maven.version>

        <version.library.bobthebuildtool>12</version.library.bobthebuildtool>
        <version.library.jcli>2.0.0</version.library.jcli>
        <version.library.handlebars>4.5.7</version.library.handlebars>
        <version.library.trimou>2.5.1.Final</version.library.trimou>
        <version.library.pebble>4.1.2</version.library.pebble>
        <version.library.freemarker>2.3.35</version.library.freemarker>
        <version.library.velocity>2.4.1</version.library.velocity>
        <version.library.slf4j>2.0.20</version.library.slf4j>
        <version.library.junit>6.1.3</version.library.junit>

        <version.plugin.check-cves>1.1.0</version.plugin.check-cves>
        <version.plugin.codegrade>0.2.0</version.plugin.codegrade>
        <version.plugin.enforcer>3.6.3</version.plugin.enforcer>
        <version.plugin.surefire>3.6.0</version.plugin.surefire>
        <version.plugin.jar>3.5.1</version.plugin.jar>
        <version.plugin.license-check>1.3.0</version.plugin.license-check>
        <version.plugin.shade>3.6.2</version.plugin.shade>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>bobthebuildtool</artifactId>
            <version>${version.library.bobthebuildtool}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>jcli</artifactId>
            <version>${version.library.jcli}</version>
        </dependency>

        <dependency>
            <groupId>com.github.jknack</groupId>
            <artifactId>handlebars</artifactId>
            <version>${version.library.handlebars}</version>
        </dependency>

        <dependency>
            <groupId>org.trimou</groupId>
            <artifactId>trimou-core</artifactId>
            <version>${version.library.trimou}</version>
        </dependency>

        <dependency>
            <groupId>io.pebbletemplates</groupId>
            <artifactId>pebble</artifactId>
            <version>${version.library.pebble}</version>
        </dependency>

        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
            <version>${version.library.freemarker}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>${version.library.velocity}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${version.library.junit}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${version.library.slf4j}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${version.plugin.enforcer}</version>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${maven.version}</version>
                                    <message>This project requires Maven ${maven.version} to build</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.plugin.surefire}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${version.plugin.jar}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Bob-Plugin-Class>templateer.BobPlugin</Bob-Plugin-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${version.plugin.shade}</version>
                <executions>
                    <execution>
                        <id>shade</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>${project.artifactId}</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/9/OSGI-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>
                                        <exclude>META-INF/AL2.0</exclude>
                                        <exclude>META-INF/LGPL2.1</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/com.google.code.findbugs/jsr305/pom.properties</exclude>
                                        <exclude>META-INF/maven/com.google.code.findbugs/jsr305/pom.xml</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Bob-Plugin-Class>templateer.BobPlugin</Bob-Plugin-Class>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <minimizeJar>false</minimizeJar>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>

        <profile>
            <id>licenses</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-license</artifactId>
                        <version>${version.plugin.license-check}</version>
                        <executions>
                            <execution><goals><goal>check</goal></goals></execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                            <rules>
                                <rule>name:regex:BSD(\s|-)3-Clause( License)?</rule>
                                <rule>name:equal:GNU General Public License v2.0 w/Classpath exception</rule>
                                <rule>url:regex:http(s)?://www.apache.org/licenses/LICENSE-2.0.txt</rule>
                                <rule>url:equal:https://www.eclipse.org/legal/epl-v20.html</rule>
                                <rule>url:regex:https://opensource.org/license(s)?/(mit|MIT)</rule>
                            </rules>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>vulnerabilities</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-cves</artifactId>
                        <version>${version.plugin.check-cves}</version>
                        <executions>
                            <execution><goals><goal>check</goal></goals></execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>codequality</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>codegrade-maven-plugin</artifactId>
                        <version>${version.plugin.codegrade}</version>
                        <executions>
                            <execution><goals><goal>check</goal></goals></execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

    </profiles>

</project>